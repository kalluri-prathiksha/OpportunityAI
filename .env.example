# OpportunityAI Environment Variables Template

# Server Configuration
PORT=5000
NODE_ENV=development

# Optional External AI API Key (OpenAI / Gemini)
# If left blank, the built-in Semantic Ontology Matching & Explanation Engine executes with 100% functionality
OPENAI_API_KEY=
GEMINI_API_KEY=

# Supabase PostgreSQL & Auth Credentials (Optional)
# If left blank, the built-in persistent in-memory database store executes with full features out of the box
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Email Reminder Service (Optional for simulated dispatch)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
